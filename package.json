{
  "name": "expenses-monorepo",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=packages/desktop",
    "start:mobile": "npm run start --workspace=packages/mobile",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:desktop": "npm run build --workspace=packages/desktop",
    "build:all": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:all": "npm run test --workspaces",
    "typecheck:all": "npm run typecheck --workspaces",
    "electron:dev": "npm run electron:dev --workspace=packages/desktop",
    "electron:build": "npm run electron:build --workspace=packages/desktop"
  },
  "dependencies": {
    "7zip-bin": "~5.2.0",
    "app-builder-bin": "4.0.0",
    "electron-builder": "24.13.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
