{
  "name": "expense-tracker",
  "private": true,
  "version": "1.0.31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit; if ($LASTEXITCODE -ne 0) { exit 1 }; vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "electron:dev": "scripts\\electron-dev.cmd",
    "electron:build": "vite build; if ($LASTEXITCODE -ne 0) { exit 1 }; electron-builder",
    "electron:pack": "electron-builder --dir"
  },
  "dependencies": {
    "@expenses/shared": "file:../shared",
    "animejs": "^4.3.1",
    "dompurify": "^3.3.1",
    "electron-updater": "^6.3.0",
    "i18next": "^23.15.1",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.27.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tar": "^7.5.7",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "tar": "^7.5.7"
  },
  "description": "A beautiful, full-featured expense tracking application for managing household finances between two partners. Built with React, TypeScript, Tailwind CSS, and localStorage persistence.",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.juhertra.expenses",
    "electronVersion": "35.7.5",
    "productName": "Expenses",
    "icon": "resources/icon.png",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Juhertra",
        "repo": "Expenses"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juhertra/Expenses.git"
  },
  "author": "Hernan Trajtemberg",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Juhertra/Expenses/issues"
  },
  "homepage": "https://github.com/Juhertra/Expenses#readme"
}
