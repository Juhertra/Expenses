{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@expenses/shared": ["../shared/src/index.ts"],
      "@expenses/shared/calculations": ["../shared/src/lib/calculations.ts"],
      "@expenses/shared/defaults": ["../shared/src/lib/defaults.ts"],
      "@expenses/shared/importExport": ["../shared/src/services/importExport.ts"],
      "@expenses/shared/normalization": ["../shared/src/lib/normalization.ts"],
      "@expenses/shared/recurring": ["../shared/src/services/recurring/index.ts"],
      "@expenses/shared/types": ["../shared/src/lib/types.ts"],
      "@expenses/shared/validators": ["../shared/src/lib/validators.ts"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
